      "sensitive": true,
      "requiredFragments": [
        "persist-purge-tombstone",
        "disconnect-streams-and-polling",
        "bounded-remote-revocation",
        "remove-persisted-account-credentials",
        "clear-application-cache-storage",
        "revoke-object-urls-and-temporary-resources",
        "complete-purge-tombstone"
      ]
