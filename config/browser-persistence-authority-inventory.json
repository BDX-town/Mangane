    {
      "id": "origin-emergency-reset",
      "path": "app/soapbox/persistence/emergency-reset.ts",
      "engine": "multi-surface-coordinator",
      "scope": "origin",
      "classification": "destructive-recovery",
      "sensitive": true,
      "requiredFragments": [
        "clear-local-storage",
        "clear-indexeddb-kv-store",
        "clear-cache-storage",
        "close-notifications-and-unregister-workers",
        "final-clear-local-storage"
