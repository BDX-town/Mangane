{
  "schemaVersion": 2,
  "status": "phase-0c-verified",
  "surfaces": [
    {
      "id": "auth-local-storage",
      "path": "app/soapbox/reducers/auth.js",
      "engine": "localStorage",
      "scope": "deployment-multi-account",
      "classification": "credential-authority",
      "sensitive": true,
      "requiredFragments": [
        "const STORAGE_KEY = buildKey([NAMESPACE, 'auth']);",
        "readStoredJSON(localStorage, STORAGE_KEY)",
        "writeStoredJSON(localStorage, STORAGE_KEY, state.toJS())"
      ]
    },
    {
      "id": "account-credential-cleanup",
      "path": "app/soapbox/persistence/auth-storage.ts",
      "engine": "localStorage/sessionStorage",
      "scope": "deployment-account",
      "classification": "fail-closed-credential-cleanup",
      "sensitive": true,
      "requiredFragments": [
        "removePersistedAccountCredentials",
        "delete auth.users[accountUrl]",
        "localStorage.removeItem(key)",
        "sessionStorage.removeItem(key)"
      ]
    },
    {
      "id": "indexeddb-account-snapshot",
      "path": "app/soapbox/persistence/purge.ts",
      "engine": "localForage/IndexedDB",
      "scope": "account-url",
      "classification": "account-cache-cleanup",
      "sensitive": true,
      "requiredFragments": [
        "KVStore.removeItem(`authAccount:${scope.accountUrl}`)",
        "remove-account-snapshot"
      ]
    },
    {
      "id": "durable-lifecycle-generation",
