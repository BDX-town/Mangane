      "path": "app/soapbox/persistence/object-urls.ts",
      "engine": "object-url",
      "scope": "page-lifetime",
      "classification": "temporary-resource-registry",
      "sensitive": false,
      "requiredFragments": [
        "activeObjectUrls",
        "createTrackedObjectURL",
        "revokeTrackedObjectURL",
        "revokeAllTrackedObjectURLs"
