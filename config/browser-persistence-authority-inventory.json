  "invariants": {
    "allDiscoveredCallsClassified": true,
    "credentialCleanupFailsClosed": true,
    "crossTabMessagesContainNoBearerTokens": true,
    "lateResponsesAndWritesAreGenerationFenced": true,
    "normalLogoutClearsOwnedCaches": true,
    "objectUrlsAreCentrallyRevocable": true,
    "purgeIsOrderedIdempotentResumableAndFailureIsolated": true,
    "workerRevocationSurvivesWorkerRestart": true
  },
  "documentedConstraints": [
    "HttpOnly cookies are server authority and cannot be enumerated or deleted by application JavaScript; logout and OAuth revocation remain their remote cleanup boundary.",
    "Browser or operating-system termination can interrupt any in-flight cleanup; the durable account tombstone causes cleanup to resume at the next application bootstrap.",
    "Cache Storage cleanup is deliberately limited to application-owned prefixes during account purge; emergency reset removes every origin-visible cache.",
    "Object URLs created outside the tracked application helper cannot be enumerated by browser APIs and are prohibited by the persistence discovery gate."
  ]
}
