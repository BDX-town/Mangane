        "revokeAccountGeneration",
        "isAccountGenerationActive",
        "StaleSessionGenerationError"
      ]
    },
    {
      "id": "http-response-generation-fence",
      "path": "app/soapbox/api.ts",
      "engine": "Axios-interceptor",
      "scope": "account-and-tab-generation",
      "classification": "stale-response-rejection",
      "sensitive": true,
      "requiredFragments": [
        "client.interceptors.response.use",
        "assertSessionGenerationActive(sessionGeneration)",
        "isAccountGenerationActive(accountGeneration)"
      ]
    },
    {
      "id": "stream-generation-fence",
      "path": "app/soapbox/stream.ts",
      "engine": "WebSocket-and-polling-registry",
      "scope": "tab-session-generation",
      "classification": "stale-stream-rejection-and-disconnect",
      "sensitive": true,
      "requiredFragments": [
        "activeDisconnectors",
        "disconnectAllStreams",
        "captureSessionGeneration",
        "isSessionGenerationActive",
        "if (generationIsActive()) onReceive(data)"
