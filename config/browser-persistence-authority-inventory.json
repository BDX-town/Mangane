  "surfaces": [
    {
      "id": "auth-local-storage",
      "path": "app/soapbox/reducers/auth.js",
      "engine": "localStorage",
      "scope": "deployment-multi-account",
      "classification": "credential-authority",
      "sensitive": true,
      "requiredFragments": [
        "const STORAGE_KEY = buildKey([NAMESPACE, 'auth']);",
        "localStorage.getItem(STORAGE_KEY)",
        "localStorage.setItem(STORAGE_KEY, JSON.stringify(state.toJS()))"
      ]
    },
    {
      "id": "auth-session-selection",
      "path": "app/soapbox/reducers/auth.js",
      "engine": "sessionStorage",
      "scope": "tab-selected-account",
      "classification": "selection-marker",
      "sensitive": true,
      "requiredFragments": [
        "const SESSION_KEY = buildKey([NAMESPACE, 'auth', 'me']);",
        "sessionStorage.getItem(SESSION_KEY)",
        "sessionStorage.setItem(SESSION_KEY, me)"
      ]
    },
    {
