      ]
    },
    {
      "id": "offline-cache-cleanup",
      "path": "app/soapbox/persistence/cache-storage.ts",
      "engine": "CacheStorage",
      "scope": "application-owned-cache-prefixes",
      "classification": "normal-transition-cleanup",
      "sensitive": false,
      "requiredFragments": [
