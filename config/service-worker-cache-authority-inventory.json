{
  "schemaVersion": 1,
  "status": "verified-current-bounded",
  "productionConfig": {
    "path": "webpack/production.js",
    "cacheName": "soapbox",
    "serviceWorkerEntry": "app/soapbox/service_worker/entry.ts",
    "appShellUsesFrontendSubdirectory": true,
    "autoUpdate": true,
    "events": true,
    "minify": true,
    "safeToUseOptionalCaches": true,
    "navigationRequestTypes": ["navigate"],
    "mainCaches": [":rest:"],
    "additionalCaches": [
      ":externals:",
      "packs/images/32-*.png",
      "packs/icons/*.svg"
    ],
    "optionalCaches": [
      "**/locale_*.js",
      "**/*_polyfills-*.js",
      "**/*.chunk.js",
      "**/*.chunk.css",
      "**/*.woff2",
      "**/*.png",
      "**/*.svg"
    ],
    "backendRoutePrefixes": [
      "/.well-known",
      "/activities",
      "/admin",
      "/api",
      "/auth",
      "/inbox",
      "/instance",
      "/internal",
      "/main/ostatus",
      "/manifest.json",
      "/media",
      "/nodeinfo",
      "/oauth",
      "/objects",
      "/ostatus_subscribe",
      "/pghero",
      "/pleroma",
      "/proxy",
      "/relay",
      "/sidekiq",
      "/socket",
      "/static",
      "/unsubscribe"
    ],
    "backendEmbedSuffix": "/embed"
  },
  "entry": {
    "path": "app/soapbox/service_worker/entry.ts",
    "imports": [
      "./web_push_notifications",
      "./share_target"
    ]
  },
  "purge": {
    "path": "app/soapbox/persistence/cache-storage.ts",
    "ownedPrefixes": ["soapbox", "webpack-offline"],
    "protectedCaches": ["soapbox-private-revocations-v1"]
  },
  "canonicalDocumentation": {
    "path": "docs/architecture/SERVICE_WORKER_CACHE_AUTHORITY_DRIFT_GATE.md"
  },
  "invariants": {
    "productionNavigationUsesAppShellFallback": true,
    "backendRoutesBypassAppShellRewrite": true,
    "cacheInputsAreBuildAssetsAndAppShell": true,
    "backendNavigationRoutesBypassAppShell": true,
    "accountPurgeDeletesOwnedCachePrefixes": true,
    "workerRevocationCacheIsProtectedFromNormalPurge": true
  },
  "explicitUnknowns": [
    "The inherited global cache name is deployment-origin scoped rather than build-version scoped; account purge treats its contents as disposable public shell assets.",
    "Generated OfflinePlugin cache suffixes are library-owned, so normal purge matches reviewed prefixes instead of hard-coding generated names.",
    "Cache rollback, corruption and quota dispositions are documented; OfflinePlugin internal upgrade mechanics remain library-owned.",
    "Backend-route prefix completeness and production edge rewrite precedence require end-to-end verification.",
    "Cross-origin asset redirect, credential mode and response content-type behavior remain transport and deployment concerns."
  ]
}
